{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "libri-desempenho",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-25",

  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "libriconvites.com.br/api/desempenho*",
      "zone_name": "libriconvites.com.br"
    }
  ],

  "vars": {
    "APP_TIMEZONE": "America/Sao_Paulo",
    "MAIN_HOST": "libriconvites.com.br",
    "MEDIA_HOST": "midia.libriconvites.com.br",
    "EXCLUDED_SLUGS": "editor,motor,painel-desempenho,teste-motor"
  },

  "secrets": {
    "required": [
      "ADMIN_PASSWORD",
      "SESSION_SECRET",
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ZONE_ID"
    ]
  },

  "observability": {
    "enabled": true
  }
}
